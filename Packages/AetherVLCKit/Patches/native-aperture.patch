+/* Native aperture metadata helpers: no pixel access or copying. */
+typedef struct {
+    double clean[4]; /* width, height, horizontal/vertical center offset */
+    double sar[2];
+} NativeApertureMetadata;
+
+typedef enum {
+    NativeApertureReady,
+    NativeApertureInvalidGeometry,
+    NativeApertureConflictingMetadata,
+    NativeApertureAllocationFailure,
+} NativeApertureStatus;
+
+static bool NativeApertureGeometry(uint64_t W, uint64_t H,
+                                  uint64_t x, uint64_t y,
+                                  uint64_t w, uint64_t h,
+                                  unsigned sar_num, unsigned sar_den,
+                                  unsigned rotation, unsigned post_flip,
+                                  uint64_t output_W, uint64_t output_H,
+                                  NativeApertureMetadata *metadata)
+{
+    if (!metadata || W == 0 || H == 0 || W > UINT32_MAX || H > UINT32_MAX ||
+        x > W || y > H || w == 0 || h == 0 || w > W - x || h > H - y ||
+        sar_num == 0 || sar_den == 0 ||
+        (post_flip & ~(kVLCSampleBufferPixelFlip_H | kVLCSampleBufferPixelFlip_V)))
+        return false;
+
+    uint64_t final_W = W, final_H = H;
+    switch (rotation) {
+    case kVLCSampleBufferPixelRotation_0:
+        break;
+    case kVLCSampleBufferPixelRotation_90CW: {
+        const uint64_t original_x = x, original_w = w;
+        x = H - y - h;
+        y = original_x;
+        w = h;
+        h = original_w;
+        final_W = H;
+        final_H = W;
+        break;
+    }
+    case kVLCSampleBufferPixelRotation_180:
+        x = W - x - w;
+        y = H - y - h;
+        break;
+    case kVLCSampleBufferPixelRotation_90CCW: {
+        const uint64_t original_x = x, original_w = w;
+        x = y;
+        y = W - original_x - original_w;
+        w = h;
+        h = original_w;
+        final_W = H;
+        final_H = W;
+        break;
+    }
+    default:
+        return false;
+    }
+    /* Public VTPixelRotationProperties.h: flips are applied after rotation. */
+    if (post_flip & kVLCSampleBufferPixelFlip_H)
+        x = final_W - x - w;
+    if (post_flip & kVLCSampleBufferPixelFlip_V)
+        y = final_H - y - h;
+    if (final_W != output_W || final_H != output_H)
+        return false;
+
+    metadata->clean[0] = (double)w;
+    metadata->clean[1] = (double)h;
+    metadata->clean[2] = (double)x + (double)w / 2 - (double)final_W / 2;
+    metadata->clean[3] = (double)y + (double)h / 2 - (double)final_H / 2;
+    const bool swapped = rotation == kVLCSampleBufferPixelRotation_90CW ||
+                         rotation == kVLCSampleBufferPixelRotation_90CCW;
+    metadata->sar[0] = swapped ? sar_den : sar_num;
+    metadata->sar[1] = swapped ? sar_num : sar_den;
+    return true;
+}
+
+static bool NativeReadCleanAperture(CFTypeRef attachment, uint64_t W, uint64_t H,
+                                  double values[4])
+{
+    if (!attachment || CFGetTypeID(attachment) != CFDictionaryGetTypeID())
+        return false;
+    const CFStringRef keys[] = {
+        kCVImageBufferCleanApertureWidthKey, kCVImageBufferCleanApertureHeightKey,
+        kCVImageBufferCleanApertureHorizontalOffsetKey,
+        kCVImageBufferCleanApertureVerticalOffsetKey,
+    };
+    for (unsigned i = 0; i < 4; ++i) {
+        CFTypeRef value = CFDictionaryGetValue((CFDictionaryRef)attachment, keys[i]);
+        if (!value || CFGetTypeID(value) != CFNumberGetTypeID() ||
+            !CFNumberGetValue((CFNumberRef)value, kCFNumberDoubleType, &values[i]) ||
+            !isfinite(values[i]))
+            return false;
+    }
+    const double x = (double)W / 2 + values[2] - values[0] / 2;
+    const double y = (double)H / 2 + values[3] - values[1] / 2;
+    return values[0] > 0 && values[1] > 0 && x >= 0 && y >= 0 &&
+           x <= (double)W && y <= (double)H &&
+           values[0] <= (double)W - x && values[1] <= (double)H - y;
+}
+
+static CFDictionaryRef NativeCreateNumericDictionary(const CFStringRef *keys,
+                                                     const double *values,
+                                                     unsigned count)
+{
+    CFNumberRef numbers[4] = {NULL, NULL, NULL, NULL};
+    CFDictionaryRef dictionary = NULL;
+    if (count == 0 || count > 4)
+        return NULL;
+    for (unsigned i = 0; i < count; ++i) {
+        numbers[i] = CFNumberCreate(kCFAllocatorDefault, kCFNumberDoubleType, &values[i]);
+        if (!numbers[i])
+            goto cleanup;
+    }
+    dictionary = CFDictionaryCreate(kCFAllocatorDefault, (const void **)keys,
+                                    (const void **)numbers, count,
+                                    &kCFTypeDictionaryKeyCallBacks,
+                                    &kCFTypeDictionaryValueCallBacks);
+cleanup:
+    for (unsigned i = 0; i < count; ++i)
+        if (numbers[i])
+            CFRelease(numbers[i]);
+    return dictionary;
+}
+
+static NativeApertureStatus NativeApplyApertureMetadata(CVPixelBufferRef buffer,
+                                                       const NativeApertureMetadata *metadata)
+{
+    if (!buffer || !metadata)
+        return NativeApertureInvalidGeometry;
+    CFTypeRef existing;
+    if (@available(iOS 15.0, tvOS 15.0, macOS 12.0, *)) {
+        existing = CVBufferCopyAttachment(buffer, kCVImageBufferCleanApertureKey, NULL);
+    } else {
+        /* Keep the upstream engine deployment target's older API contract. */
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+        existing = CVBufferGetAttachment(buffer, kCVImageBufferCleanApertureKey, NULL);
+#pragma clang diagnostic pop
+        if (existing)
+            CFRetain(existing);
+    }
+    double existing_values[4];
+    const bool existing_valid = NativeReadCleanAperture(existing,
+        CVPixelBufferGetWidth(buffer), CVPixelBufferGetHeight(buffer), existing_values);
+    bool matching = existing_valid;
+    if (existing_valid)
+        for (unsigned i = 0; i < 4; ++i)
+            matching &= fabs(existing_values[i] - metadata->clean[i]) <= 0.000001;
+    if (existing)
+        CFRelease(existing);
+    if (existing_valid && !matching)
+        return NativeApertureConflictingMetadata;
+
+    const CFStringRef clean_keys[] = {
+        kCVImageBufferCleanApertureWidthKey, kCVImageBufferCleanApertureHeightKey,
+        kCVImageBufferCleanApertureHorizontalOffsetKey,
+        kCVImageBufferCleanApertureVerticalOffsetKey,
+    };
+    const CFStringRef sar_keys[] = {
+        kCVImageBufferPixelAspectRatioHorizontalSpacingKey,
+        kCVImageBufferPixelAspectRatioVerticalSpacingKey,
+    };
+    CFDictionaryRef clean = matching ? NULL : NativeCreateNumericDictionary(clean_keys, metadata->clean, 4);
+    if (!matching && !clean)
+        return NativeApertureAllocationFailure;
+    CFDictionaryRef sar = NativeCreateNumericDictionary(sar_keys, metadata->sar, 2);
+    if (!sar) {
+        if (clean)
+            CFRelease(clean);
+        return NativeApertureAllocationFailure;
+    }
+    /* Both dictionaries exist before either native attachment is changed. */
+    if (clean)
+        CVBufferSetAttachment(buffer, kCVImageBufferCleanApertureKey, clean, kCVAttachmentMode_ShouldPropagate);
+    CVBufferSetAttachment(buffer, kCVImageBufferPixelAspectRatioKey, sar, kCVAttachmentMode_ShouldPropagate);
+    if (clean)
+        CFRelease(clean);
+    CFRelease(sar);
+    return NativeApertureReady;
+}
+/* End native aperture metadata helpers. */
+
+static void NativeApertureReportFailure(vout_display_t *vd,
+                                       VLCSampleBufferDisplay *sys,
+                                       const char *message)
+{
+    @synchronized(sys) {
+        if (!sys.nativeApertureDiagnosticLogged) {
+            sys.nativeApertureDiagnosticLogged = YES;
+            msg_Err(vd, "%s", message);
+        }
+    }
 }
 
