+/* Called with _bufferLock held once all pending blocks are enqueued. */
+- (void)armDrainObserver
+{
+    if (!_drainRequested || _drainObserver != nil || _outChain != NULL
+     || _ptsSamples <= 0)
+        return;
+
+    const CMTime end = CMTimeMake(_ptsSamples, _sampleRate);
+    __weak typeof(self) weakSelf = self;
+    _drainObserver = [_sync addBoundaryTimeObserverForTimes:@[[NSValue valueWithCMTime:end]]
+                                                    queue:_timeQueue
+                                               usingBlock:^{
+        [weakSelf reportDrainedIfReady];
+    }];
+}
+
+- (void)reportDrainedIfReady
+{
+    vlc_mutex_lock(&_bufferLock);
+    if (!_drainRequested || _paused || _outChain != NULL)
+    {
+        vlc_mutex_unlock(&_bufferLock);
+        return;
+    }
+
+    const int64_t samples = _ptsSamples;
+    const vlc_tick_t first = _firstPts;
+    const CMTime current = [_sync currentTime];
+    const BOOL hasSamples = samples > 0;
+    if (hasSamples && (_stopped || !_dateReached || !CMTIME_IS_NUMERIC(current)
+        || CMTimeCompare(current, CMTimeMake(samples, _sampleRate)) < 0))
+    {
+        vlc_mutex_unlock(&_bufferLock);
+        return;
+    }
+    vlc_mutex_unlock(&_bufferLock);
+
+    /* Report the real renderer point before completion. TimingReport takes
+     * the core timing lock, so it must run without _bufferLock held. */
+    if (hasSamples)
+        aout_TimingReport(_aout, vlc_tick_now(),
+                         first + [VLCAVSample CMTimeTotick:current]);
+
+    vlc_mutex_lock(&_bufferLock);
+    if (_drainRequested && !_paused && _outChain == NULL && _ptsSamples == samples
+        && _firstPts == first && (!hasSamples || !_stopped))
+    {
+        _drainRequested = NO;
+        /* Completion and periodic timing callbacks share _timeQueue. Stop
+         * producing timing points once the physical queue has drained. The
+         * core flushes before any subsequent play, resetting this state. */
+        _stopped = YES;
+        vlc_cond_signal(&_bufferWait);
+        /* DrainedReport only stores the core's atomic drained flag. Keeping
+         * this lock excludes flush/stop cancellation from this report. */
+        aout_DrainedReport(_aout);
+    }
+    vlc_mutex_unlock(&_bufferLock);
+}
+
+- (void)drain
+{
+    vlc_mutex_lock(&_bufferLock);
+    _drainRequested = YES;
+    [self armDrainObserver];
+    vlc_mutex_unlock(&_bufferLock);
+    __weak typeof(self) weakSelf = self;
+    dispatch_async(_timeQueue, ^{
+        [weakSelf reportDrainedIfReady];
+    });
+}
