--- a/src/input/decoder.c
+++ b/src/input/decoder.c
@@ -242,6 +242,8 @@
 
     /* Flushing */
     bool flushing;
+    /* Only a flushed video can bypass pause until its preview is queued. */
+    bool video_flush_preview_pending;
     bool b_draining;
     bool b_idle;
     bool aborting;
@@ -341,6 +343,8 @@
     *  pausing */
     int next_request_count = owner->frames_countdown;
     owner->frames_countdown = vout_NextPicture(owner->video.vout, next_request_count);
+    /* The original pause acknowledgement already registered this preview. */
+    owner->video_flush_preview_pending = false;
 
     assert(next_request_count >= owner->frames_countdown);
     /* Notify for pictures that are processes by the vout */
@@ -1542,6 +1546,24 @@
         return VLC_EGENERIC;
     }
 
+    if (p_owner->video_flush_preview_pending)
+    {
+        if (p_owner->paused && p_owner->output_paused)
+        {
+            p_owner->video_flush_preview_pending = false;
+            if (p_owner->frames_countdown > 0)
+                p_owner->frames_countdown--;
+            /* Register before queueing: PutPicture wakes the vout. The NEXT
+             * path reports only this actual post-preroll picture PTS. */
+            vout_NextPicture(p_vout, 1);
+            vout_PutPicture(p_vout, p_picture);
+            decoder_Notify(p_owner, frame_next_status, 0);
+            return VLC_SUCCESS;
+        }
+        if (!p_owner->paused && !p_owner->b_waiting)
+            p_owner->video_flush_preview_pending = false;
+    }
+
     if (unlikely(p_owner->output_paused && p_owner->frames_countdown > 0))
     {
         p_owner->frames_countdown--;
@@ -2043,7 +2065,8 @@
             continue;
         }
 
-        if( p_owner->paused && p_owner->frames_countdown == 0 )
+        if( p_owner->paused && p_owner->frames_countdown == 0
+         && !(p_owner->cat == VIDEO_ES && p_owner->video_flush_preview_pending) )
         {   /* Wait for resumption from pause */
             p_owner->b_idle = true;
             vlc_cond_signal( &p_owner->wait_acknowledge );
@@ -2204,6 +2227,7 @@
     p_owner->error = false;
 
     p_owner->flushing = false;
+    p_owner->video_flush_preview_pending = false;
     p_owner->b_draining = false;
     atomic_init( &p_owner->reload, RELOAD_NO_REQUEST );
     p_owner->b_idle = false;
@@ -2784,6 +2808,8 @@
      * dequeued by DecoderThread and there is no need to flush a second time in
      * a row. */
     p_owner->flushing = true;
+    p_owner->video_flush_preview_pending = cat == VIDEO_ES
+                                        && p_owner->frames_countdown != -1;
     p_owner->b_draining = false;
 
     /* Flush video/spu decoder when paused: increment frames_countdown in order
@@ -2897,6 +2923,10 @@
     p_owner->paused = b_paused;
     p_owner->pause_date = i_date;
     p_owner->frames_countdown = 0;
+    if (b_paused && p_owner->cat == VIDEO_ES && p_owner->video_flush_preview_pending)
+        p_owner->frames_countdown = 1;
+    else if (!b_paused)
+        p_owner->video_flush_preview_pending = false;
     vlc_fifo_Signal( p_owner->p_fifo );
     vlc_fifo_Unlock( p_owner->p_fifo );
 }
